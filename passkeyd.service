[Unit]
Description=WebAuthn authenticator
After=systemd-udevd.service
Documentation=https://github.com/bjn7/passkeyd

[Service]
Type=simple
ExecStart=/usr/bin/passkeyd
Restart=on-failure
StandardOutput=journal
StandardError=journal

# passkeyd stays root: it reads /etc/shadow for the password fallback, opens
# /dev/uhid and the TPM device, and asks systemd to spawn each UI as the user
# at the console. Those all need root, and it has to serve every user, so it
# cannot drop to a fixed account or group. What can be narrowed is narrowed
# below.

# --- Filesystem -------------------------------------------------------------
# Everything is read-only except the passkey store, which systemd creates and
# owns. /etc/passkeyd.conf and /usr/share/passkeyd/theme.conf stay readable.
ProtectSystem=strict
StateDirectory=passkeyd/database
StateDirectoryMode=0700
ProtectHome=yes
PrivateTmp=yes

# --- Kernel -----------------------------------------------------------------
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Hides other processes from /proc; passkeyd never inspects them.
ProtectProc=invisible

# --- Process ----------------------------------------------------------------
NoNewPrivileges=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077

# The set systemd recommends as a starting point for system services: regular
# IO and the calls a daemon needs, without the special-purpose ones. It is
# roomy by design, which matters here — the TPM stack reaches the kernel
# through several layers, and a hand-written allow-list would have to be
# validated against a running daemon to avoid denying something it needs.
SystemCallFilter=@system-service

# Root reaches its files by ownership — /etc/shadow and the passkey store are
# root-owned and /dev/uhid is root-only — so no capability is needed. If the
# daemon ever fails to open something it owns, this is the first thing to
# loosen.
CapabilityBoundingSet=
AmbientCapabilities=

# --- Devices ----------------------------------------------------------------
# PrivateDevices must NOT be enabled: it would hide /dev/uhid and the TPM,
# which is the whole point of the daemon. Allow those two explicitly instead.
# /dev/null, /dev/urandom and friends are always available.
#
# Device node paths, not char-<group>. A "char-uhid" specifier can never match:
# char-<name> refers to a device group as listed in /proc/devices, and uhid is
# a misc device, listed in /proc/misc instead. Worse, systemd does not report
# it — an unmatched DeviceAllow= is accepted silently, and the failure only
# shows up later as the daemon being denied permission to create the uhid
# device. The same trap applies to the TPM ("char-tpm" happens to work, being
# a real /proc/devices group, but the path is clearer and cannot drift).
#
# DevicePolicy=closed is belt and braces. With an explicit DeviceAllow= present
# the default "auto" already stops allowing everything, and "closed" differs
# only in naming the standard pseudo devices out loud. It is stated anyway so
# that deleting a DeviceAllow= line cannot quietly widen access back to every
# device in the system.
DevicePolicy=closed
DeviceAllow=/dev/uhid rw
DeviceAllow=/dev/tpmrm0 rw

# --- Network ----------------------------------------------------------------
# passkeyd has no reason to speak IP. The one outbound request it makes is
# fetching a user icon at registration; that call already tolerates failure, so
# the icon is simply left empty. AF_UNIX carries D-Bus, AF_NETLINK carries udev.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any

[Install]
WantedBy=multi-user.target

[Unit]
Description=WebAuthn authenticator
After=systemd-udevd.service
Documentation=https://github.com/bjn7/passkeyd

[Service]
Type=simple
ExecStart=/usr/bin/passkeyd
Restart=on-failure
StandardOutput=journal
StandardError=journal

# passkeyd stays root: it reads /etc/shadow for the password fallback, opens
# /dev/uhid and the TPM device, and asks systemd to spawn each UI as the user
# at the console. Those all need root, and it has to serve every user, so it
# cannot drop to a fixed account or group. What can be narrowed is narrowed
# below.

# --- Filesystem -------------------------------------------------------------
# Everything is read-only except the passkey store, which systemd creates and
# owns. /etc/passkeyd.conf and /usr/share/passkeyd/theme.conf stay readable.
ProtectSystem=strict
StateDirectory=passkeyd/database
StateDirectoryMode=0700
ProtectHome=yes
PrivateTmp=yes

# --- Kernel -----------------------------------------------------------------
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# Hides other processes from /proc; passkeyd never inspects them.
ProtectProc=invisible

# --- Process ----------------------------------------------------------------
NoNewPrivileges=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077

# Root reaches its files by ownership, so no capabilities are needed. If you
# build with TPM support and something below fails, this is the setting to
# loosen first.
CapabilityBoundingSet=
AmbientCapabilities=

# --- Devices ----------------------------------------------------------------
# PrivateDevices must NOT be enabled: it would hide /dev/uhid and the TPM,
# which is the whole point of the daemon. Allow those two explicitly instead.
# /dev/null, /dev/urandom and friends are always available.
# Numeric major:minor rather than the char-<group> names: /dev/uhid is
# misc 10:239 and the TPM resource manager is 252:65536. systemd does not
# validate group names, so a misspelling would fail silently, whereas these
# cannot be misread.
DevicePolicy=closed
DeviceAllow=char-10:239 rw
DeviceAllow=char-252:65536 rw

# --- Network ----------------------------------------------------------------
# passkeyd has no reason to speak IP. The one outbound request it makes is
# fetching a user icon at registration; that call already tolerates failure, so
# the icon is simply left empty. AF_UNIX carries D-Bus, AF_NETLINK carries udev.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
